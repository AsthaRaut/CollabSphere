# Copy this file to ".env" and fill in your own values
PORT=5000

# MongoDB Atlas (or local) connection string
MONGO_URI=

# Any long random string, e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# Public URL of this API (used to build file links)
SERVER_URL=http://localhost:5000
